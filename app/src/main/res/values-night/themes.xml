<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KreaWorkbench" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <!-- r29.1：启动页只显示紫色 logomark，透明底（不再借 adaptive icon 的白底圆）。 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.Krea.NoWindow</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
