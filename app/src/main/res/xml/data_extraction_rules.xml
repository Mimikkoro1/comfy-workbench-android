<?xml version="1.0" encoding="utf-8"?>
<!-- 排除含服务器凭据的 DataStore，其余照常备份 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/krea_settings.preferences_pb" />
        <exclude domain="file" path="datastore/krea_settings.preferences_pb.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/krea_settings.preferences_pb" />
        <exclude domain="file" path="datastore/krea_settings.preferences_pb.tmp" />
    </device-transfer>
</data-extraction-rules>
